<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(FLAVOR_APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(FLAVOR_APP_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- .fuzz files: Fuzzzy Ink opens them (Open), and declares the type, a plain
	     binary. A file that arrives is copied once into the private hand-off folder
	     (incoming_files.dart) and never run. The person's own file is left where it is. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Fuzzzy Ink locked file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.fuzzzycore.ink.fuzz</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.fuzzzycore.ink.fuzz</string>
			<key>UTTypeDescription</key>
			<string>Fuzzzy Ink locked file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fuzz</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Export compliance: the app does use encryption (Rust core: Olm, XChaCha20-Poly1305,
	     Argon2id), but only standard algorithms, and it is not distributed in France. App
	     Store Connect's App Encryption Documentation, answered that way, classes it as
	     exempt and issues no compliance code, so the key is false. Setting it true without
	     an issued code fails every upload (error 90592). Record: documents/security/RELEASE.md §6.4. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Mac App Store requires a category (owner's choice: Productivity). -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Authenticate to unlock your Fuzzzy Ink password.</string>
</dict>
</plist>
