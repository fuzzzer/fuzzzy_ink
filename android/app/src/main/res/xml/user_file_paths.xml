<?xml version="1.0" encoding="utf-8"?>
<!-- The only folder the app's own FileProvider (UserFiles.kt) may hand out by
     content URI: the private hand-off folder (files/handoff), where a file
     lives only while it is being shared and is wiped right after. The store
     key, the vault and the sealed files are never reachable. -->
<paths>
    <files-path name="handoff" path="handoff/" />
</paths>
