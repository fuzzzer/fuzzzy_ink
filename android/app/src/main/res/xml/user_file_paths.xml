<?xml version="1.0" encoding="utf-8"?>
<!-- Roots the app's own FileProvider (UserFiles.kt, T-0366) may hand out by
     content URI: the public Downloads folder where fuzzed and unfuzzed files
     land, and the app's files/cache for anything staged there. -->
<paths>
    <external-path name="downloads" path="Download/" />
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
</paths>
