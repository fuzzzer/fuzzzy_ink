<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Same exclusions as backup_rules.xml, for cloud backup AND
     device-to-device transfer (allowBackup="false" alone no longer covers transfer):
     THREAT_MODEL.md §2.8 / R34. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
